#!/usr/bin/env python3

import os
import sys
import time

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"))

from utils import (  # noqa: E402
    cards,
    set_audio_device,
    show_audio_menu,
    switch_card_profile,
    switchable_outputs,
)

# Called by kanshi when the display setup changes:
#   audio-output --switch hdmi     (docked: send sound to the monitor)
#   audio-output --switch analog   (undocked: back to the laptop speakers)
PORTS = {"hdmi": "hdmi-output", "analog": "analog-output"}


def switch(target: str, timeout: float = 15.0) -> None:
    # Retry: at login PipeWire may not be up yet, and a monitor's audio port only
    # becomes available a moment after the display is enabled.
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        if any(c["active_profile"].startswith(f"output:{target}") for c in cards()):
            return  # already on that output
        outputs = switchable_outputs(PORTS[target])
        if outputs:
            card, profile, _desc = outputs[0]
            switch_card_profile(card, profile)
            return
        time.sleep(1)
    # nothing to switch: already on that output, or it isn't connected


if __name__ == "__main__":
    if len(sys.argv) == 3 and sys.argv[1] == "--switch" and sys.argv[2] in PORTS:
        switch(sys.argv[2])
    elif selection := os.environ.get("ROFI_INFO"):
        set_audio_device("sinks", selection, "󰕾 Output Changed")
    else:
        show_audio_menu("sinks", "󰕾", "Audio Output", "Current Output")
