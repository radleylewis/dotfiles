#!/usr/bin/env python3

import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"))

from utils import set_audio_device, show_audio_menu  # noqa: E402

if __name__ == "__main__":
    if selection := os.environ.get("ROFI_INFO"):
        set_audio_device("sources", selection, "󰍬 Microphone Changed")
    else:
        show_audio_menu("sources", "󰍬", "Microphone", "Current Input")
