#!/usr/bin/env python3

import os
import subprocess
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"))

from utils import notify  # noqa: E402

performance_icon = "󱓞"
balanced_icon = "󰓅"
quiet_icon = "󰁻"


def get_current_profile() -> str:
    return subprocess.run(
        ["powerprofilesctl", "get"],
        capture_output=True,
        text=True,
    ).stdout.strip()


def performance_profile_menu() -> None:
    opts = [
        ["performance", performance_icon],
        ["balanced", balanced_icon],
        ["saver", quiet_icon],
    ]

    current_profile = get_current_profile()
    print("\0prompt\x1fProfile")
    print(f"\0message\x1fCurrent Profile: {current_profile}")

    for mode, icon in opts:
        print(f"{icon} {mode}{chr(0)}info\x1f{mode.lower()}")


def set_performance_profile(profile: str) -> None:
    result = subprocess.run(
        ["powerprofilesctl", "set", profile],
        capture_output=True,
        text=True,
        check=False,
    )
    if result.returncode == 0:
        notify("⚡ Performance Mode", f"Set to: {profile.capitalize()}", expire_time=2_000)
    else:
        notify(
            "⚡ Performance Mode",
            f"Could not set {profile}: {result.stderr.strip()}",
            expire_time=4_000,
            urgency="critical",
        )


if __name__ == "__main__":
    selection = os.environ.get("ROFI_INFO")

    if selection:
        set_performance_profile(selection)
    else:
        performance_profile_menu()
