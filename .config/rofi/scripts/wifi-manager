#!/usr/bin/env python3

import os
import re
import subprocess
import sys
from typing import List, Optional
from dataclasses import dataclass

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"))

from utils import ROFI_DIR, notify  # noqa: E402

shut_lock = ""
open_lock = ""
wifi_enable = "󰖩"
wifi_disable = "󰖪"
wifi_known = "󰆓"
connect_icon = "󱘖"
forget_icon = "󰩹"
back_icon = "󰁍"
new_icon = "󰐕"

NOTIFY_TITLE = f"{wifi_enable}  WiFi Manager"
TOGGLE_WIFI = "TOGGLE_WIFI"
BACK = "BACK"
CONNECT = "CONNECT"
FORGET = "FORGET"


@dataclass(slots=True)
class WifiNetwork:
    ssid: str
    security: Optional[str]
    saved: bool
    visible: bool


def _unescape(field: str) -> str:
    """nmcli -t escapes ':' and '\\' inside fields with a backslash."""
    return re.sub(r"\\(.)", r"\1", field)


def _is_secured(security: Optional[str]) -> bool:
    # Open networks show an empty SECURITY field (or "--")
    return bool(security) and security != "--"


def _notify_result(result: subprocess.CompletedProcess, success_message: str) -> None:
    if result.returncode == 0:
        notify(title=NOTIFY_TITLE, message=success_message, expire_time=3_000, urgency="low")
    else:
        error = (result.stderr or result.stdout).strip() or "unknown error"
        notify(
            title=NOTIFY_TITLE,
            message=f"Failed: {error}",
            expire_time=5_000,
            urgency="critical",
        )


def get_saved_networks() -> List[str]:
    """return a list of saved wifi networks"""
    saved_connections = subprocess.run(
        ["nmcli", "-t", "-f", "NAME,TYPE", "connection", "show"],
        capture_output=True,
        text=True,
    ).stdout.splitlines()

    saved_networks = []
    for connection in saved_connections:
        if connection.endswith("wireless"):
            saved_networks.append(_unescape(connection.rsplit(":", 1)[0]))

    return saved_networks


def list_wifi_networks() -> dict[str, WifiNetwork]:

    saved_networks = get_saved_networks()

    visible_networks = subprocess.run(
        ["nmcli", "-t", "-f", "SECURITY,SSID", "device", "wifi", "list"],
        capture_output=True,
        text=True,
    ).stdout.splitlines()

    networks: dict[str, WifiNetwork] = {}

    for network in visible_networks:
        security, ssid = network.split(":", 1)
        ssid = _unescape(ssid)
        if ssid:
            saved = ssid in saved_networks
            networks[ssid] = WifiNetwork(
                ssid=ssid, security=security, saved=saved, visible=True
            )
    return networks


def is_wifi_enabled() -> bool:
    result = subprocess.run(
        ["nmcli", "-fields", "WIFI", "g"],
        capture_output=True,
        text=True,
    )
    return "enabled" in result.stdout


def show_wifi_networks():
    notify(
        title=NOTIFY_TITLE,
        message="Getting list of available WiFi networks",
        expire_time=2_000,
    )

    wifi_enabled = is_wifi_enabled()
    wifi_networks: dict[str, WifiNetwork] = {}

    options: dict[str, str] = {}

    if wifi_enabled:
        toggle_label = f"{wifi_disable}  Disable Wi-Fi"
        options[toggle_label] = TOGGLE_WIFI

        wifi_networks = list_wifi_networks()
        networks = sorted(
            wifi_networks.values(),
            key=lambda network: (not network.saved),
        )
    else:
        toggle_label = f"{wifi_enable}  Enable Wi-Fi"
        options[toggle_label] = TOGGLE_WIFI
        networks = []

    for network in networks:
        label = ""

        if network.saved:
            label += wifi_known
        elif _is_secured(network.security):
            label += shut_lock
        else:
            label += open_lock

        # IMPORTANT: strip only for display
        ssid_display = network.ssid.rstrip()
        label += f"  {ssid_display}"

        # map label -> real ssid
        options[label] = network.ssid

    result = subprocess.run(
        [
            "rofi",
            "-dmenu",
            "-i",
            "-selected-row",
            "1",
            "-p",
            f" {wifi_enable}",
            "-theme",
            f"{ROFI_DIR}/wifi.rasi",
        ],
        input="\n".join(options.keys()),
        text=True,
        capture_output=True,
    ).stdout.rstrip("\n")

    if not result:
        return None, wifi_networks

    selection = options.get(result)
    if selection is None:  # free text typed that isn't in the list
        return None, wifi_networks

    # Toggle selected
    if selection == TOGGLE_WIFI:
        return TOGGLE_WIFI, wifi_networks

    # Network selected → return actual WifiNetwork object
    return wifi_networks[selection], wifi_networks


def toggle_wifi() -> None:
    if is_wifi_enabled():
        subprocess.run(["nmcli", "radio", "wifi", "off"])
        notify(title=NOTIFY_TITLE, message="Disabling Wi-Fi")
    else:
        subprocess.run(["nmcli", "radio", "wifi", "on"])
        notify(title=NOTIFY_TITLE, message="Enabling Wi-Fi")


def connect_existing_network(network: WifiNetwork) -> None:
    result = subprocess.run(
        ["nmcli", "connection", "up", "id", network.ssid],
        capture_output=True,
        text=True,
    )
    _notify_result(result, f"Connected to Wi-Fi network: {network.ssid}")


def prompt_for_password(ssid: str) -> str:
    password = subprocess.run(
        [
            "rofi",
            "-dmenu",
            "-password",
            "-p",
            f"{shut_lock} Enter Password for {ssid}:",
            "-theme",
            f"{ROFI_DIR}/password.rasi",
        ],
        capture_output=True,
        text=True,
    ).stdout.strip()
    return password


def connect_new_network(network: WifiNetwork) -> None:
    cmd = ["nmcli", "device", "wifi", "connect", network.ssid]

    if _is_secured(network.security):
        pwd = prompt_for_password(network.ssid)
        if not pwd:  # prompt cancelled
            return
        cmd += ["password", pwd]

    result = subprocess.run(
        cmd,
        capture_output=True,
        text=True,
    )
    _notify_result(result, f"Connected to new Wi-Fi network: {network.ssid}")


def forget_network(network: WifiNetwork) -> None:
    result = subprocess.run(
        [
            "nmcli",
            "connection",
            "delete",
            "id",
            network.ssid,
        ],
        capture_output=True,
        text=True,
    )
    _notify_result(result, f"Removed Wi-Fi network: {network.ssid}")


def show_selected_network(
    selected_network: WifiNetwork, networks: dict[str, WifiNetwork]
):

    if network := networks.get(selected_network.ssid):
        title = f" {wifi_enable}  {network.ssid}"

        connect_label = f"{connect_icon} {CONNECT}"
        forget_label = f"{forget_icon} {FORGET}"
        back_label = f"{back_icon} {BACK}"

        if network.saved:
            title += f" [{wifi_known} existing network]"
            options = [connect_label, forget_label, back_label]
        else:
            title += f" [{new_icon} new network]"
            options = [connect_label, back_label]

        choice = subprocess.run(
            [
                "rofi",
                "-dmenu",
                "-i",
                "-p",
                f"{title}",
                "-theme",
                f"{ROFI_DIR}/wifi.rasi",
            ],
            input="\n".join(options),
            text=True,
            capture_output=True,
        ).stdout.strip()
        # Escape returns "" and typed text may have no icon prefix
        parts = choice.split(" ", 1)
        action = parts[1] if len(parts) == 2 else None

        if action == BACK:
            wifi_manager()
        elif action == CONNECT:
            if selected_network.saved:
                connect_existing_network(selected_network)
            else:
                connect_new_network(selected_network)
        elif action == FORGET:
            forget_network(selected_network)
            wifi_manager()


def wifi_manager() -> None:
    selection, networks = show_wifi_networks()
    if selection == TOGGLE_WIFI:
        toggle_wifi()
    elif isinstance(selection, WifiNetwork):
        show_selected_network(selection, networks)


if __name__ == "__main__":
    wifi_manager()
